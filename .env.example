# Copy to .env and fill in. Never commit .env to git.
#
# Generating random keys:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Token from @BotFather. Required.
TELEGRAM_BOT_TOKEN=

# PostgreSQL connection. Required.
DATABASE_URL=postgresql+asyncpg://translator_bot:PASSWORD@127.0.0.1:5432/translator_bot

# Signs the web panel's session cookie. Required.
# Safe to rotate at any time; the only effect is that signed-in admins are
# logged out.
SESSION_SECRET_KEY=

# The Fernet key that encrypts users' API keys is derived from this. Required:
# the services refuse to start without it, and it must NOT be the same value as
# SESSION_SECRET_KEY.
# WARNING: this key cannot be rotated. Change it and every stored API key
# becomes unreadable, and every user has to run /setapikey again.
API_KEY_ENCRYPTION_KEY=

# Address and port the web panel binds to. Leave these alone if you put nginx
# in front of it as a reverse proxy.
PANEL_HOST=127.0.0.1
PANEL_PORT=8000

# Comma-separated addresses or CIDR ranges allowed to set X-Forwarded-For.
# The default is right when nginx runs on the same host. A request from any
# other address is attributed to that address itself, so a direct caller
# cannot forge its own IP and slip past the per-IP login lockout.
TRUSTED_PROXIES=127.0.0.1,::1

# Comma-separated Host header values the panel answers to, e.g.
# example.com,www.example.com. Use * to disable the check.
PANEL_ALLOWED_HOSTS=*

# Default global daily translation limit. Also changeable from the panel.
DEFAULT_DAILY_MESSAGE_LIMIT=500

LOG_LEVEL=INFO

# Set this to development only on your own machine: that is the only case in
# which this file is read through python-dotenv. In production the secrets come
# from systemd-creds or from the environment.
ENV=production
