# Copy to .env and fill in. Never commit .env to git.
#
# Generating random keys:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Token from @BotFather. Required.
TELEGRAM_BOT_TOKEN=

# PostgreSQL connection. Required.
DATABASE_URL=postgresql+asyncpg://translator_bot:PASSWORD@127.0.0.1:5432/translator_bot

# Signs the web panel's session cookie. Required. Safe to rotate at any time; the only effect is that signed-in admins are logged out.
SESSION_SECRET_KEY=

# The Fernet key that encrypts users' API keys is derived from this. Required: the services refuse to start without it, and it must NOT be the same value as SESSION_SECRET_KEY.
# WARNING: this key cannot be rotated. Change it and every stored API key becomes unreadable, and every user has to run /setapikey again.
API_KEY_ENCRYPTION_KEY=

# Address and port the web panel binds to. Leave these alone if you put nginx in front of it as a reverse proxy.
PANEL_HOST=127.0.0.1
PANEL_PORT=8000

# Comma-separated addresses or CIDR ranges allowed to set X-Forwarded-For. The default is right when nginx runs on the same host. A request from any other address is attributed to that address itself, so a direct caller cannot forge its own IP and slip past the per-IP login lockout.
TRUSTED_PROXIES=127.0.0.1,::1

# Comma-separated Host header values the panel answers to, e.g. example.com,www.example.com. Use * to disable the check.
PANEL_ALLOWED_HOSTS=*

# Where this version's source code can be fetched. The bot shows it in /source and the panel shows it in the footer. This project is AGPL-3.0: if you modify it and let anyone use your modified version, you owe them its source, so a fork must point this at the fork rather than at the original repository.
SOURCE_URL=https://github.com/BlindSoldier52/translator_bot

# Telegram's cloud Bot API never hands a bot a file larger than 20 MB, so 20 is the ceiling unless you run your own telegram-bot-api server. If you do, point the two URLs below at it, set TELEGRAM_LOCAL_MODE=true, and raise MAX_FILE_SIZE_MB to whatever that server allows, up to 2000. A value the configured API cannot serve is refused at startup rather than failing halfway through a download.
TELEGRAM_API_BASE_URL=https://api.telegram.org/bot
TELEGRAM_API_BASE_FILE_URL=https://api.telegram.org/file/bot
TELEGRAM_LOCAL_MODE=false
MAX_FILE_SIZE_MB=20

# How much of a file the bot will actually translate, whatever its size on disk. Raising MAX_FILE_SIZE_MB alone changes little for text-heavy documents: these are what bind. A batch is one API call, so MAX_BATCHES_PER_FILE is also the cost ceiling for a single file.
MAX_EXTRACTED_CHARS=400000
MAX_BATCHES_PER_FILE=60
MAX_BATCHES_PER_IMAGE=20

# Default global daily translation limit. Also changeable from the panel.
DEFAULT_DAILY_MESSAGE_LIMIT=500

LOG_LEVEL=INFO

# Set this to development only on your own machine: that is the only case in which this file is read through python-dotenv. In production the secrets come from systemd-creds or from the environment.
ENV=production
