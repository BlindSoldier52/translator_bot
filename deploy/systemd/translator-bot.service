# Replace /opt/translator-bot with the real install path before copying this
# file into /etc/systemd/system/.

[Unit]
Description=Translator Bot - Telegram bot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=translatorbot
Group=translatorbot
WorkingDirectory=/opt/translator-bot
Environment=ENV=production

LoadCredentialEncrypted=translator-bot-env:/etc/translator-bot/env.cred
ExecStart=/bin/bash -c 'set -a; source "${CREDENTIALS_DIRECTORY}/translator-bot-env"; exec /opt/translator-bot/venv/bin/python -m bot'

Restart=always
RestartSec=5

MemoryHigh=1G
MemoryMax=2G
TasksMax=256
LimitNOFILE=4096
CPUQuota=200%

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
